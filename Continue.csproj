<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>Continue</AssemblyName>
    <RootNamespace>minortom.Continue</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>minortom</Authors>
    <Description>Main-menu Continue button for the last Valheim character and world or server.</Description>
    <RestoreAdditionalProjectSources>
      https://nuget.bepinex.dev/v3/index.json;
      https://api.nuget.org/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExDir)/core/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)/core/0Harmony.dll" Private="false" />

    <Reference Include="assembly_valheim" HintPath="$(ValheimManaged)/assembly_valheim.dll" Publicize="true" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManaged)/assembly_utils.dll" Publicize="true" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ValheimManaged)/assembly_guiutils.dll" Publicize="true" Private="false" />
    <Reference Include="gui_framework" HintPath="$(ValheimManaged)/gui_framework.dll" Private="false" />
    <Reference Include="Splatform" HintPath="$(ValheimManaged)/Splatform.dll" Publicize="true" Private="false" />
    <Reference Include="SoftReferenceableAssets" HintPath="$(ValheimManaged)/SoftReferenceableAssets.dll" Publicize="true" Private="false" />
    <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(ValheimManaged)/com.rlabrecque.steamworks.net.dll" Private="false" />

    <Reference Include="UnityEngine" HintPath="$(ValheimManaged)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ValheimManaged)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ValheimManaged)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ValheimManaged)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ValheimManaged)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ValheimManaged)/Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyToProfile" AfterTargets="Build" Condition="Exists('$(BepInExDir)/plugins')">
    <MakeDir Directories="$(BepInExDir)/plugins/Continue" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)/plugins/Continue" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Installed $(TargetFileName) -> $(BepInExDir)/plugins/Continue" />
  </Target>
</Project>
